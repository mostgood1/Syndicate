{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Loading Syndicate ledger..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lane-guard.py",
            "timeout": 15,
            "statusMessage": "Checking lane ownership..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkpoint-guard.sh",
            "timeout": 30,
            "statusMessage": "Checking for uncheckpointed work..."
          }
        ]
      }
    ]
  }
}
