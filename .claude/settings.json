{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Loading Syndicate ledger..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lane-guard.py",
            "timeout": 15,
            "statusMessage": "Checking lane ownership..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lanes-append-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-guard.py",
            "timeout": 25,
            "statusMessage": "Checking the shared git index..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-commit-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deploy-guard.py",
            "timeout": 15,
            "statusMessage": "Checking deploy ownership..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkpoint-guard.py",
            "timeout": 30,
            "statusMessage": "Checking for uncheckpointed work..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-postwrite-check.py"
          }
        ]
      }
    ]
  }
}
