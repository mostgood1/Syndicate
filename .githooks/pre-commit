#!/bin/sh
# Syndicate pre-commit hook -- ledger invariants for EVERY commit, not just the
# ones a Claude Code session makes.
#
# WHY THIS EXISTS ALONGSIDE `.claude/hooks/ledger-commit-guard.py`. That guard is
# a PreToolUse hook: it only sees commits made through a session's Bash tool. The
# commit that actually did the damage on 2026-09-02 (`376bfa94`, a kalshi code
# change carrying a ~90-commit-stale lanes.md, reverting a trim pass and leaving
# 14 duplicated blocks) is exactly the shape that a hook outside the session
# cannot catch. git is the choke point every commit passes through.
#
# THE PREDICATES ARE NOT RESTATED HERE. Both guards call
# `.claude/hooks/ledger_invariants.py` -- two guards disagreeing about what
# "broken" means is worse than one guard.
#
# FAILS OPEN, DELIBERATELY AND IN EVERY DIRECTION: no python, no checker, a
# crash, an unreadable index -- all exit 0. A pre-commit hook that blocks on its
# own bug is worse than the defect it guards, so ONLY an explicit exit 1 (a real
# violation) stops a commit.
#
# Bypass:  SYNDICATE_ALLOW_LEDGER_COMMIT=1 git commit ...
#     or:  git commit --no-verify
[ "${SYNDICATE_ALLOW_LEDGER_COMMIT:-}" = "1" ] && exit 0

DIR=$(dirname "$0")
CHECK="$DIR/ledger_precommit.py"
[ -f "$CHECK" ] || exit 0

# PROBE BEFORE USE (lane precommit-python-probe, 2026-10-14). On Windows `python3` is often the WindowsApps App
# Execution Alias: it is on PATH, and from some shells (a backgrounded Git Bash, measured on commit 857ec54b) it
# cannot start at all -- "Permission denied", exit 126. The old loop ran the FIRST name found and treated that 126
# as fail-open, so the ledger check was skipped with no trace. A candidate now has to run `import sys` before it is
# trusted, so a broken alias falls through to `python` / `py -3`.
for PY in python3 python "py -3"; do
    set -- $PY
    command -v "$1" >/dev/null 2>&1 || continue
    "$@" -c "import sys" >/dev/null 2>&1 || continue
    "$@" "$CHECK"
    rc=$?
    # ONLY 1 blocks. 0 = clean; anything else = the checker itself failed.
    [ "$rc" -eq 1 ] && exit 1
    exit 0
done
# Still fail-open (see the header), but NOT silent: a commit that skipped the guard says so.
echo "WARN: pre-commit ledger guard did NOT run -- no Python could start (tried python3, python, py -3)." >&2
exit 0
