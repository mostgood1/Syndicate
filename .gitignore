data/mlb_source/source_artifacts/data/daily/snapshots/*/schedule_raw.json
data/mlb_source/source_artifacts/data/daily/snapshots/*/team_rosters_raw.json
data/mlb_source/source_artifacts/data/daily/snapshots/*/injuries_raw.json
data/mlb_source/source_artifacts/data/daily/snapshots/*/meta.json

