.venv/
__pycache__/
.env
.env.*
!.env.example
*.py[cod]
.pytest_cache/
.mypy_cache/

.vscode/

tmp_*.log
tmp_*.json
tmp_*.py
tmp_*.txt
tmp_*.xml
.tmp_*.json
*.tmp
