# Timestamped run outputs are operational artifacts; keep rolling latest files tracked.
reports/daily_update/*/*/
!reports/daily_update/latest/
reports/daily_update/latest/unified_daily_update_latest.json
reports/migration_runs/**
!reports/migration_runs/mirror_contract_smoke/
reports/refresh_status/*/*/
!reports/refresh_status/latest/

# Local mirror caches and scratch outputs should not be committed.
data/*_source/data/cache/
data/*_source/source_artifacts/data/cache/
data/*_source/source_artifacts/
data/tmp_*/

# Team-branding snapshots (logo URL + hex colors, ~few KB/sport, changes only
# on a rebrand) are real Render deploy inputs -- unlike the rest of
# source_artifacts/, which is bulky and regenerable, cards.py has no other
# source for these and Render's persistent disk never runs the ESPN fetch
# itself. Un-ignore just this one path per sport rather than the whole
# source_artifacts/ tree.
!data/nfl_source/source_artifacts/
data/nfl_source/source_artifacts/*
!data/nfl_source/source_artifacts/data/
data/nfl_source/source_artifacts/data/*
!data/nfl_source/source_artifacts/data/processed/
data/nfl_source/source_artifacts/data/processed/*
!data/nfl_source/source_artifacts/data/processed/team_branding/
!data/ncaaf_source/source_artifacts/
data/ncaaf_source/source_artifacts/*
!data/ncaaf_source/source_artifacts/data/
data/ncaaf_source/source_artifacts/data/*
!data/ncaaf_source/source_artifacts/data/processed/
data/ncaaf_source/source_artifacts/data/processed/*
!data/ncaaf_source/source_artifacts/data/processed/team_branding/

# SmartSim 2.0 historical-truth caches: regenerable via ncaaf_historical_loader.py /
# nfl_historical_loader.py (CFBD API / nflverse release download); mirror caches, not source.
# Exception: NCAAF's games_{season}.json.gz (schedule-level, ~40-95KB each,
# not the bulky drives/plays play-by-play caches) IS a real Render deploy
# input -- confirmed 2026-08-02: ncaaf/cards.py's _smartsim2_standalone_rows
# calls load_games_season() directly in the request path (not just at
# generation time), and Render's persistent disk has no production job that
# ever runs ncaaf_historical_loader.py itself to regenerate this cache, so
# without it committed the standalone SmartSim 2.0 cards/picks fallback
# silently returns no rows for any season the legacy engine has no data for.
data/nfl_source/historical_truth/
!data/ncaaf_source/historical_truth/
data/ncaaf_source/historical_truth/*
!data/ncaaf_source/historical_truth/games_*.json.gz

# Raw NFL tracking pulls (nflverse pbp, FTN charting): regenerable release
# downloads, not source, and individual files run 90MB+ -- too large for
# GitHub history.
data/nfl_source/tracking/

# Accidental/tooling virtualenvs outside the standard .venv/ name.
vendor/mlb_bettingv2/.venv_x64/

# Ad hoc local test-run output, not source.
/test_stdout.log
/test_stderr.log
reports/live_refresh_loop/weather_fetch.log

# Verification screenshots from the run-syndicate skill smoke test.
.claude/skills/run-syndicate/screenshots/

# Generated source trees are operational artifacts, not Render deploy inputs.
data/*_source/data/
vendor/*/data/

# NCAAF's real SmartSim 2.0 projection artifacts nest under data/ncaaf_source/data/
# (NFL's own equivalent avoids this by living directly under nfl_source/, no
# nested data/ dir) -- these ARE a real Render deploy input (cards.py/picks.py's
# standalone fallback reads them directly), unlike the ~300 other scratch/cache
# files this directory otherwise holds (cfbd_lines caches, timestamped historical
# predicted-totals snapshots), which should stay ignored.
!data/ncaaf_source/data/
data/ncaaf_source/data/*
!data/ncaaf_source/data/smartsim2_projections_*.csv

# Temporary helper scripts should stay local.
scripts/tmp_*.py

