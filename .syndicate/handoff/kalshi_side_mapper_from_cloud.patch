+def _ticker_team_is_home(venue_ticker: Any) -> bool | None:
+    """Is the team named in this ticker the HOME team? None if unreadable.
+
+    ------------------------------------------------------------------
+    THE VENUE HAS NO HOME/AWAY AXIS. IT NAMES A TEAM.
+    ------------------------------------------------------------------
+
+    Measured from the live venue 2026-08-26 (event `KXMLBSPREAD-26AUG261907KCTOR`,
+    KC @ TOR) -- SIX markets, both teams times three strikes:
+
+        KXMLBSPREAD-...-KC2   floor_strike 1.5   "Kansas City wins by over 1.5"
+        KXMLBSPREAD-...-TOR2  floor_strike 1.5   "Toronto wins by over 1.5"
+        ... -KC3/-TOR3 at 2.5, -KC4/-TOR4 at 3.5
+
+    So `home`/`away` is not a thing to MAP -- it is a thing to RESOLVE against
+    the ticker. Our team is the one the ticker names (`yes`) or the other one
+    (`no`): TOR +1.5 is NO on `-KC2`, because KC failing to win by more than 1.5
+    IS Toronto +1.5.
+
+    `yes_sub_title == no_sub_title` on these markets, so the side CANNOT be read
+    from the sub-title -- it does not discriminate. The ticker suffix is the
+    only signal, which is why this reads the suffix and nothing else.
+
+    EXACTLY ONE OF THE TWO TESTS MUST HOLD. A code that both starts and ends the
+    pair, or neither, is a string we do not understand, and guessing which team
+    we just bought is the most expensive mistake available in this file -- it
+    buys the OPPONENT at a price that looked right. `None` means refuse.
+    """
+    text = str(venue_ticker or "").strip().upper()
+    parts = text.split("-")
+    if len(parts) < 3:
+        return None
+    event, suffix = parts[1], parts[2]
+    # Strip the trailing strike digits: `KC2` -> `KC`, `TOR` -> `TOR`.
+    team = suffix.rstrip("0123456789")
+    if not team:
+        return None
+    stripped = _EVENT_DATE_PREFIX.sub("", event)
+    if not stripped or team not in stripped:
+        return None
+    starts = stripped.startswith(team)
+    ends = stripped.endswith(team)
+    if starts == ends:
+        # Both or neither. Both would need a team to play itself; neither means
+        # the pair is not two concatenated codes. Either way we cannot say.
+        return None
+    return ends
+
+
