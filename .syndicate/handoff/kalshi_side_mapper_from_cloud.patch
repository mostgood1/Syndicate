+def test_a_team_spread_resolves_against_the_ticker_not_a_home_away_vocabulary():
+    """MEASURED AT THE VENUE 2026-08-26, event `KXMLBSPREAD-26AUG261907KCTOR`.
+
+    Six markets, both teams times three strikes, all `strike_type: greater`:
+
+        -KC2  floor_strike 1.5  "Kansas City wins by over 1.5 runs?"
+        -TOR2 floor_strike 1.5  "Toronto wins by over 1.5 runs?"
+        -KC3/-TOR3 at 2.5, -KC4/-TOR4 at 3.5
+
+    So `unmappable_side: 'away' market='spreads'` -- 11 orders/cycle -- was
+    never a missing vocabulary entry. THE VENUE HAS NO HOME/AWAY AXIS. It names
+    a team, and our side is `yes` on our team's contract or `no` on the
+    opponent's.
+
+    `yes_sub_title == no_sub_title` on these markets, so the side cannot be read
+    from the sub-title; the ticker suffix is the only signal.
+    """
+    from syndicate.features.shared.kalshi_orders import _side_to_kalshi
+
+    KC2 = "KXMLBSPREAD-26AUG261907KCTOR-KC2"
+    TOR2 = "KXMLBSPREAD-26AUG261907KCTOR-TOR2"
+
+    # KC is AWAY (first code in `KCTOR`). "KC -1.5" is YES on the KC contract.
+    assert _side_to_kalshi("away", "spreads", KC2) == "yes"
+    # "TOR +1.5" is NO on the SAME contract -- KC failing to win by more than
+    # 1.5 IS Toronto +1.5. This is the row that used to refuse.
+    assert _side_to_kalshi("home", "spreads", KC2) == "no"
+    # And "TOR -1.5" is YES on Toronto's own contract.
+    assert _side_to_kalshi("home", "spreads", TOR2) == "yes"
+    assert _side_to_kalshi("away", "spreads", TOR2) == "no"
+
+
+def test_the_moneyline_resolves_by_the_same_rule_and_keeps_its_old_answer():
+    """H2H has the identical shape -- `KXMLBGAME-...-KC` / `-TOR`, two markets.
+
+    The old code returned `yes` unconditionally because the board join stamps
+    OUR team's ticker. That stays true, so the answer must not change for a
+    correctly stamped row -- but it is now DERIVED rather than assumed, which is
+    what makes a mis-stamped ticker fail loudly instead of buying the opponent.
+    """
+    from syndicate.features.shared.kalshi_orders import _side_to_kalshi
+
+    assert _side_to_kalshi("away", "h2h", "KXMLBGAME-26AUG261907KCTOR-KC") == "yes"
+    assert _side_to_kalshi("home", "h2h", "KXMLBGAME-26AUG261907KCTOR-TOR") == "yes"
+    # The mis-stamp that used to be invisible: our HOME side on the AWAY team's
+    # contract is a NO, not a YES.
+    assert _side_to_kalshi("home", "h2h", "KXMLBGAME-26AUG261907KCTOR-KC") == "no"
+    # No ticker at all keeps the old behaviour for callers that pass none.
+    assert _side_to_kalshi("home", "h2h") == "yes"
+
+
